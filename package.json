{
  "name": "gitpolis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Procedural 3D city built from any GitHub profile",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-serverless.mjs",
    "build:serverless": "node scripts/build-serverless.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:gemini:live": "vite-node scripts/test-gemini-live.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.0.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^16.5.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.1.0",
    "vitest": "^3.2.7"
  }
}
