# GitPolis environment overrides
# Copy this file to .env, then restart the server. Rebuild after changing VITE_*.
# Every value has a working default. Never commit .env.

# ---- Server-only secrets ----
# These are read by the Vite middleware and are never sent to the browser.

# Optional. Raises the anonymous GitHub budget from 60 to 5,000 requests/hour
# and enables deeper commit and language analysis.
GITHUB_TOKEN=

# Optional. Lets visitors generate AI plans without entering their own key.
# A server key takes precedence over keys entered in the app.
GEMINI_API_KEY=

# ---- Gemini models ----

# Model used by the server-side /api/gemini/decisions proxy.
# Default: gemini-3.5-flash. If it is unavailable, GitPolis falls back to
# gemini-3-flash-preview, then gemini-2.5-flash.
GEMINI_MODEL=gemini-3.5-flash

# Model used only when the browser calls Gemini directly, such as on static
# hosting without the API proxy. Default: gemini-3.5-flash.
# This value is embedded in the public bundle; rebuild after changing it.
# Never put a secret here.
VITE_GEMINI_MODEL=gemini-3.5-flash

# ---- Dev and preview servers ----

# Port for `npm run dev`.
PORT=5173

# Port for `npm run preview`.
PREVIEW_PORT=4173

# Set to 1 to bind either server to 0.0.0.0 for LAN testing.
# Leave unset for localhost-only access.
GITPOLIS_LAN=

# Extra Host header values accepted by Vite, comma-separated.
# Useful for tunnels or custom domains.
GITPOLIS_ALLOWED_HOSTS=

# Set to 1 only behind a reverse proxy you control. This trusts the last
# X-Forwarded-For hop for rate limiting and X-Forwarded-Host for origin checks.
GITPOLIS_TRUST_PROXY=
