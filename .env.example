# ---- Server-side (never exposed to the browser) ----

# Optional GitHub token. Raises the API budget from 60 to 5,000 req/hr for
# every visitor of this deployment and enables deeper repo analysis.
GITHUB_TOKEN=

# Optional Gemini API key. When set, the /api/gemini/decisions proxy uses it
# and visitors do not need to supply their own key.
GEMINI_API_KEY=

# Gemini model override. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# ---- Dev / preview server ----

# Port for `npm run dev` (default 5173) and `npm run preview` (default 4173).
PORT=5173
PREVIEW_PORT=4173

# Set to 1 to bind the dev server to 0.0.0.0 for LAN testing.
# Leave unset for localhost-only (recommended).
GITPOLIS_LAN=

# Extra Host headers accepted by Vite, comma-separated (e.g. tunnels).
GITPOLIS_ALLOWED_HOSTS=

# Set to 1 only behind a reverse proxy you control. Enables X-Forwarded-For
# (last hop) for rate limiting and X-Forwarded-Host for the origin check.
# Leaving it unset is correct for direct localhost/standalone deployments.
GITPOLIS_TRUST_PROXY=

# ---- Client build-time (Vite) ----

# Model used by the direct browser fallback. No API key belongs here:
# anything prefixed with VITE_ is inlined into the public bundle.
VITE_GEMINI_MODEL=gemini-2.5-flash
